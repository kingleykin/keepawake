# Maintainer: kingleykin <https://github.com/kingleykin>
#
# Repackages the official .deb. The in-app "Install" button cannot update a
# pacman install, so update through pacman or your AUR helper instead.

pkgname=keepawake-app-bin
_pkgname=keepawake-app
pkgver=1.1.0
pkgrel=1
pkgdesc="Keep your computer awake. One click, from the tray."
arch=('x86_64')
url="https://github.com/kingleykin/keepawake"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$pkgname-$pkgver.deb::$url/releases/download/v$pkgver/KeepAwake_${pkgver}_amd64.deb"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/kingleykin/keepawake/v$pkgver/LICENSE")
sha256sums=('2a755399888be1c3227f8b3b7572eb356404646533822290e07fbe8303eae1c9'
            '3e9ddba7b2f760b7bb169a894adf0ec8a66ca70a9ae69661c72867296ec2e891')
noextract=("$pkgname-$pkgver.deb")
options=('!strip' '!debug')

package() {
  bsdtar -xOf "$pkgname-$pkgver.deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
