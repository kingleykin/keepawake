{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeepAwake",
  "version": "1.0.0",
  "identifier": "io.github.kingleykin.keepawake",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KeepAwake",
        "width": 320,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "KeepAwake contributors",
    "copyright": "MIT License",
    "homepage": "https://github.com/kingleykin/keepawake",
    "shortDescription": "Keep your computer awake",
    "longDescription": "KeepAwake stops your computer from going to sleep while it is switched on. Pick a time or keep it on with no limit, from a small window or the tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"]
      }
    }
  }
}
